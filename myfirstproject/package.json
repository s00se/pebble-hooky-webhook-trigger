{
  "name": "webhooktrigger",
  "author": "Achi",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "WH Trigger",
    "uuid": "00000000-0000-0000-0000-000000000001",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": {
      "KEY_TRIGGER": 0,
      "webhook": 1,
      "clientid": 2,
      "clientsecret": 3
    },
    "resources": {
      "media": []
    },
    "capabilities": [
      "configurable"
    ],
    "configurable": {
      "clay": true
    }
  }
}

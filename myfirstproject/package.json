{
  "name": "hookly",
  "author": "Achi",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Hooky",
    "uuid": "b1372e1f-ce87-4085-bad7-991aa8d85ffb",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "diorite",
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": {
      "KEY_TRIGGER": 0,
      "webhook": 1,
      "clientid": 2,
      "clientsecret": 3
    },
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "Icon",
          "file": "images/menu_icon.png",
          "memoryFormat": "Smallest",
          "spaceOptimization": "memory",
          "menuIcon": true
        }
      ]
    },
    "capabilities": [
      "configurable"
    ],
    "configurable": {
      "clay": true
    }
  }
}
